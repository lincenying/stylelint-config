    "stylelint-scss": "^7.1.1"
  },
  "devDependencies": {
    "@lincy/stylelint-config": "workspace:*",
    "bumpp": "^11.1.0",
    "simple-open-url": "^3.0.1",
    "stylelint": "^17.12.0"
  },
  "peerDependencies": {
    "stylelint": ">=16.20.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
