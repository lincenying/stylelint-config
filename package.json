{
  "name": "@lincy/stylelint-config",
  "type": "module",
  "version": "2.2.2",
  "packageManager": "pnpm@11.2.2",
  "description": "Stylelint configuration",
  "keywords": [
    "stylelint",
    "stylelint-config",
    "standard",
    "scss"
  ],
  "repository": "lincenying/stylelint-config",
  "license": "MIT",
  "author": "lincenying",
  "main": "index.mjs",
  "files": [
    "index.mjs"
  ],
  "scripts": {
    "postpublish": "simple-open-url https://npmmirror.com/package/@lincy/stylelint-config",
    "release": "bumpp && npm publish -r --access public",
    "lint:css": "stylelint '**/*.{css,scss}' --fix"
  },
  "dependencies": {
    "@stylistic/stylelint-plugin": "^5.2.0",
    "stylelint-config-standard-scss": "^17.0.0",
